      "description": "***************************************************************************** Copyright (c) 2019 TypeFox and others.\n\nThis program and the accompanying materials are made available under the terms of the Eclipse Public License 2.0 which is available at https://www.eclipse.org/legal/epl-2.0.\n\nThis Source Code may also be made available under the following Secondary Licenses when the conditions for such availability set forth in the Eclipse Public License v. 2.0 are satisfied: GPL-3.0 which is available at https://www.gnu.org/licenses/gpl-3.0-standalone.html.\n\nSPDX-License-Identifier: EPL-2.0 OR GPL-3.0-or-later\n*****************************************************************************",
      "type": "object"
    },
    "Markup": {
      "description": "SVG or HTML markup. The views insert it as it is, so it must be trusted.",
      "type": "string"
    },
    "ModelId": {
      "description": "The `model_id` of the Jupyter widget that a `node:widget` shape draws.",
      "type": "string"
    },
    "NotchSize": {
      "description": "The size of a comment's notch in pixels: a finite number, 0 or more. 0 draws no notch. ipyelk 2.x wrote it as a string, which the view still reads.",
      "minimum": 0,
      "type": "number"
    },
    "PathData": {
      "description": "The `d` attribute of an SVG `path`: a move first, then path commands, numbers, commas and spaces.",
      "pattern": "^\\s*[Mm][\\sMmZzLlHhVvCcSsQqTtAa0-9eE+\\-.,]*$",
      "type": "string"
    },
