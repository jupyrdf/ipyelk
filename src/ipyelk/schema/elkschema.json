        "height": {
          "type": "number"
        },
        "start": {
          "type": "string"
        },
        "type": {
          "pattern": "^(?!(edge|port|label|label:icon|node|node:(path|svg|round|diamond|comment|use|image|foreignobject|widget|html))$)",
          "type": "string"
